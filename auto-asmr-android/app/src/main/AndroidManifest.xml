<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 后台播放：媒体播放类型的前台服务，通知栏控制 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 全局模式：连着服务进程时的前台服务（通知栏控制、悬浮球）、悬浮球、请用户把本 App 加进电池优化白名单 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".AsmrApp"
        android:icon="@mipmap/ic_launcher"
        android:label="auto-asmr"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                别的 App（QQ、微信、文件管理器……）里对配置文件选「用其他应用打开」时出现：只认文件名以 .ron 结尾的
                （电脑版和安卓版导出的配置都是 .ron，它们传来的地址里带原文件名），所以不会出现在别的文件的打开列表里。
                .ron 不是系统认识的类型，传过来的 MIME 可能是 application/octet-stream、*/* 或没有，所以两个过滤条件：
                一个带 mimeType="*/*"（匹配任何类型），一个不带（匹配没有类型的）。Android 12 起用 pathSuffix 精确匹配后缀；
                Android 10、11 只能用 pathPattern，它的 ".*" 遇到第一个点就停，路径里有几个点就得有一条对应的写法
                （QQ 的路径里本身就有两个点），所以写到 7 个点。打开后先检查内容，确认是配置才弹窗问要不要导入。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathSuffix=".ron" />
                <data android:pathSuffix=".RON" />
                <data android:pathPattern=".*\\.ron" />
                <data android:pathPattern=".*\\..*\\.ron" />
                <data android:pathPattern=".*\\..*\\..*\\.ron" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.ron" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.ron" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.ron" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.ron" />
                <data android:pathPattern=".*\\.RON" />
                <data android:pathPattern=".*\\..*\\.RON" />
                <data android:pathPattern=".*\\..*\\..*\\.RON" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.RON" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.RON" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.RON" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.RON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathSuffix=".ron" />
                <data android:pathSuffix=".RON" />
                <data android:pathPattern=".*\\.ron" />
                <data android:pathPattern=".*\\..*\\.ron" />
                <data android:pathPattern=".*\\..*\\..*\\.ron" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.ron" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.ron" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.ron" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.ron" />
                <data android:pathPattern=".*\\.RON" />
                <data android:pathPattern=".*\\..*\\.RON" />
                <data android:pathPattern=".*\\..*\\..*\\.RON" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.RON" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.RON" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.RON" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.RON" />
            </intent-filter>
        </activity>
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 全局模式的前台服务：连着服务进程时一直开着；被系统杀掉后会被重新拉起，连回常驻的服务进程 -->
        <service
            android:name=".global.InterceptService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Controls a Shizuku/root helper process that re-renders other apps' audio; shows status and a floating control" />
        </service>

        <!-- Shizuku 通过它把 binder 交给本 App（全局模式） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
